{
  "name": "inetometr",
  "version": "1.2.1",
  "description": "Open-source speed test service (inetometr.ru) — minimal HTML/CSS/JS, no build, no deps",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "lint": "eslint lib/ tests/",
    "format": "prettier --write \"lib/**/*.js\" \"tests/**/*.js\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"lib/**/*.js\" \"tests/**/*.js\" \"*.{js,json,md}\"",
    "e2e": "playwright test",
    "serve": "python -m http.server 8765",
    "precommit": "node scripts/precommit.js"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
